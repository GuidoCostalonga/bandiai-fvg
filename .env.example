# ─────────────────────────────────────────────────────────────
# BandiAI FVG — Environment variables
# Copy to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BandiAI FVG"

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://bandiai:bandiai@localhost:5432/bandiai?schema=public"

# ── Redis (cache + BullMQ queues) ────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth.js / NextAuth ───────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST=true

# OAuth providers (optional — leave blank to disable a provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email (magic-link) provider
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="BandiAI FVG <no-reply@bandiai.fvg>"

# ── AI provider ──────────────────────────────────────────────
# Choose the provider used by src/lib/ai/client.ts: "openai" | "anthropic"
AI_PROVIDER=anthropic
AI_EXTRACTION_MODEL=claude-sonnet-5
AI_CHAT_MODEL=claude-sonnet-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings for semantic search (pgvector). Anthropic has no embeddings API,
# so this uses an OpenAI-compatible endpoint. Falls back to OPENAI_API_KEY.
# Leave the key empty to disable semantic search (app falls back to keyword search).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Optional: point at a compatible embeddings server (e.g. a local/proxy endpoint)
EMBEDDING_BASE_URL=

# ── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Crawler ──────────────────────────────────────────────────
CRAWLER_USER_AGENT="BandiAI-FVG-Bot/1.0 (+https://bandiai.fvg/bot)"
CRAWLER_CONCURRENCY=4
CRAWLER_RATE_LIMIT_MS=1500
CRAWLER_REQUEST_TIMEOUT_MS=30000
PLAYWRIGHT_HEADLESS=true

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
